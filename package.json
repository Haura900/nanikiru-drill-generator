{
  "name": "nanikiru-drill-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "engine:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-engine.ps1",
    "test:unit": "node --test tests/cloud-sync-core.test.mjs tests/net-mature-core.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:python": "python -m pytest tests/test_tiles_and_transforms.py -q",
    "test:browser": "playwright test --config=playwright.config.cjs",
    "test": "npm run test:unit && npm run test:python && npm run test:rules && npm run test:browser"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.53.2",
    "firebase": "12.15.0",
    "firebase-tools": "15.23.0",
    "playwright": "1.53.2"
  }
}
